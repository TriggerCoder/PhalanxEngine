// GLSL port of SpartanEngine data/shaders/light_integration.hlsl @ 4c07baa (identical at upstream 67a6e8b), two
// kernels like spartan: BRDF_SPECULAR_LUT, the split sum specular lut (A, B with F = F0 * A + B) over n_dot_v (u)
// and roughness (v), and ENVIRONMENT_FILTER, the ggx prefilter of one skysphere mip (tex holds the mips below it,
// tex_uav the mip being written, values[0].x/y the mip level and count as uints).
// Deviation: none in the maths; the prefilter reads the mip chain the averaging downscale built, like spartan's
// warmup frames.
#version 460
#extension GL_GOOGLE_include_directive : require

#include "common_resources.glsl"
#include "common_light.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// van der corput radical inverse, dammertz notes on hammersley on hemisphere
float radical_inverse_vdc(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 hammersley(uint i, uint n)
{
    return vec2(float(i) / float(n), radical_inverse_vdc(i));
}

// importance sample the ggx distribution, returns a halfway vector in world space
vec3 importance_sample_ggx(vec2 Xi, vec3 N, float roughness)
{
    float alpha = D_GGX_Alpha(roughness);

    float phi       = 2.0 * PI * Xi.x;
    float cos_theta = sqrt((1.0 - Xi.y) / (1.0 + (alpha * alpha - 1.0) * Xi.y));
    float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

    vec3 H;
    H.x = cos(phi) * sin_theta;
    H.y = sin(phi) * sin_theta;
    H.z = cos_theta;

    vec3 up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent   = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    vec3 sample_vec = tangent * H.x + bitangent * H.y + N * H.z;
    return normalize(sample_vec);
}

#if defined(BRDF_SPECULAR_LUT)
// monte carlo specular brdf integral for a single f0, used to build the env lut
float integrate_brdf_scalar(float n_dot_v, float roughness, float f0_val)
{
    const uint sample_count = 1024;

    vec3 v;
    v.x = sqrt(1.0 - n_dot_v * n_dot_v);
    v.y = 0.0;
    v.z = n_dot_v;
    vec3 n = vec3(0.0, 0.0, 1.0);

    float alpha  = D_GGX_Alpha(roughness);
    float alpha2 = alpha * alpha;
    vec3  f0     = vec3(f0_val);

    float integral = 0.0;
    for (uint i = 0; i < sample_count; ++i)
    {
        vec2 Xi       = hammersley(i, sample_count);
        vec3 h        = importance_sample_ggx(Xi, n, roughness);
        vec3 l        = normalize(2.0 * dot(v, h) * h - v);
        float n_dot_l = clamp(l.z, 0.0, 1.0);
        float n_dot_h = clamp(h.z, 0.0, 1.0);
        float v_dot_h = clamp(dot(v, h), 0.0, 1.0);

        if (n_dot_l > 0.0)
        {
            // f90 must be 1, compute_f90(0) is 0 and wipes the split sum bias term
            float d    = D_GGX(n_dot_h, alpha2);
            float vis  = V_SmithGGX(n_dot_v, n_dot_l, alpha2);
            vec3  f    = F_Schlick(f0, vec3(1.0), v_dot_h);
            float brdf = (d * vis * f).r;
            float pdf  = (d * n_dot_h / (4.0 * v_dot_h)) + 1e-5;

            integral += brdf * n_dot_l / pdf;
        }
    }
    return integral / float(sample_count);
}

// split sum env lut, returns (A, B) where F = F0 * A + B
vec2 integrate_brdf(float n_dot_v, float roughness)
{
    float int0 = integrate_brdf_scalar(n_dot_v, roughness, 0.0);
    float int1 = integrate_brdf_scalar(n_dot_v, roughness, 1.0);
    return vec2(int1 - int0, int0);
}
#endif

#if defined(ENVIRONMENT_FILTER)
// prefilter the environment map for specular ibl, the blur scales with roughness
vec3 prefilter_environment(vec2 uv)
{
    float resolution      = 4096.0;
    float base_resolution = 2048.0;
    uint mip_level        = pass_uint(0u);
    uint mip_count        = pass_uint(1u);
    uint sample_count     = 512u / max(mip_level, 1u);
    float roughness       = float(mip_level) / float(mip_count - 1u);

    float phi   = uv.x * 2.0 * PI;
    float theta = (1.0 - uv.y) * PI;
    vec3 V      = normalize(vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi)));
    vec3 N      = V;

    vec3 color         = vec3(0.0);
    float total_weight = 0.0;
    for (uint i = 0u; i < sample_count; i++)
    {
        vec2 Xi       = hammersley(i, sample_count);
        vec3 H        = importance_sample_ggx(Xi, N, roughness);
        vec3 L        = normalize(2.0 * dot(V, H) * H - V);
        float n_dot_l = clamp(dot(N, L), 0.0, 1.0);
        float n_dot_h = clamp(dot(N, H), 0.0, 1.0);
        float h_dot_v = clamp(dot(H, V), 0.0, 1.0);

        if (n_dot_l > 0.0)
        {
            phi     = atan(L.z, L.x) + PI;
            theta   = acos(L.y);
            float u = (phi / (2.0 * PI)) + 0.5;
            u       = mod(u, 1.0);
            float v = 1.0 - (theta / PI);

            // pdf based mip level for proper filtering
            float alpha_ggx = D_GGX_Alpha(roughness);
            float alpha2    = alpha_ggx * alpha_ggx;
            float D         = D_GGX(n_dot_h, alpha2);
            float pdf       = (D * n_dot_h / (4.0 * h_dot_v)) + 0.0001;

            float sa_texel   = 4.0 * PI / (base_resolution * base_resolution);
            float sa_sample  = 1.0 / (float(sample_count) * pdf + 0.0001);
            float mip_sample = roughness == 0.0 ? 0.0 : 0.5 * log2(sa_sample / sa_texel);

            float resolution_factor = log2(resolution / base_resolution);
            mip_sample              = max(0.0, mip_sample - resolution_factor);

            // clamp below the mip being written, it is in unordered access during this dispatch
            float max_readable_mip = max(0.0, float(mip_level) - 1.0);
            mip_sample             = clamp(mip_sample, 0.0, max_readable_mip);

            vec3 sample_color = textureLod(sampler2D(tex, samplers[sampler_bilinear_clamp]), vec2(u, v), mip_sample).rgb;

            color        += sample_color * n_dot_l;
            total_weight += n_dot_l;
        }
    }
    // magenta marks no valid samples
    return total_weight > 0.0 ? color / total_weight : vec3(1.0, 0.0, 1.0);
}
#endif

void main()
{
    uvec2 thread_id     = gl_GlobalInvocationID.xy;
    vec2 resolution_out = vec2(imageSize(tex_uav));
    if (any(greaterThanEqual(vec2(thread_id), resolution_out)))
        return;

    vec2 uv    = (vec2(thread_id) + 0.5) / resolution_out;
    vec4 color = vec4(1.0);

#if defined(BRDF_SPECULAR_LUT)
    color.rg = integrate_brdf(uv.x, uv.y);
#endif

#if defined(ENVIRONMENT_FILTER)
    color.rgb = prefilter_environment(uv);
#endif

    imageStore(tex_uav, ivec2(thread_id), color);
}
