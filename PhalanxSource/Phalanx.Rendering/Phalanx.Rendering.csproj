<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phalanx.Rendering: renderer, materials, geometry processing (meshoptimizer), runtime GLSL -> SPIR-V,
       and the internal RHI (Rendering/RHI). The only package allowed to use unsafe code (architecture rule 10). -->
  <PropertyGroup>
    <PackageId>Phalanx.Rendering</PackageId>
    <Description>PhalanxEngine renderer with the internal Vulkan RHI, geometry processing and runtime shader compilation.</Description>
    <!-- write source-generator output to obj/.../generated so it can be inspected (VS also shows it under Dependencies > Analyzers) -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Phalanx.Tests.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <!-- runtime GLSL -> SPIR-V; pulls Silk.NET.Shaderc.Native (win-x64/x86/arm64, linux, osx shaderc_shared binaries) -->
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <!-- XxHash64 for the shader cache key -->
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <!-- meshoptimizer bindings (namespace MeshOptimizer, class Meshopt); ships runtimes/win-x64/native/meshoptimizer.dll (+ win-arm64, linux, osx) -->
    <PackageReference Include="Alimer.Bindings.MeshOptimizer" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phalanx.Core\Phalanx.Core.csproj" />
    <!-- build-time generator: Shaders/shared_buffers.glsl -> SharedBuffers.g.cs (std140/std430 structs).
         In-repo it is a project reference; from NuGet it comes inside the Phalanx.Core package. -->
    <ProjectReference Include="..\Phalanx.Generators\Phalanx.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <AdditionalFiles Include="Shaders/shared_buffers.glsl" />
  </ItemGroup>

  <ItemGroup>
    <!-- GLSL sources are compiled at runtime by ShaderCompiler; ship them next to the binaries (and inside the nupkg as contentFiles) -->
    <None Include="Shaders/**/*.glsl;Shaders/**/*.vert;Shaders/**/*.frag;Shaders/**/*.comp" Exclude="Shaders/bin/**" CopyToOutputDirectory="PreserveNewest" Link="shaders/%(RecursiveDir)%(Filename)%(Extension)" Pack="true" PackagePath="contentFiles/any/any/shaders" PackageCopyToOutput="true" />
  </ItemGroup>

</Project>
